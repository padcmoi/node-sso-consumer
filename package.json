{
  "name": "@gestionpratique/node-sso-consumer",
  "version": "0.1.2",
  "description": "SSO consumer runtime for Node.js apps: pairing, session, permissions and realtime against an x-core identity provider.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/browser.d.ts",
        "default": "./dist/client/browser.js"
      },
      "require": {
        "types": "./dist/client/browser.d.cts",
        "default": "./dist/client/browser.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express-augmentation.d.ts",
        "default": "./dist/express-augmentation.js"
      },
      "require": {
        "types": "./dist/express-augmentation.d.cts",
        "default": "./dist/express-augmentation.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/padcmoi/node-sso-consumer.git"
  },
  "homepage": "https://github.com/padcmoi/node-sso-consumer",
  "bugs": {
    "url": "https://github.com/padcmoi/node-sso-consumer/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/client/browser.ts src/express-augmentation.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write .",
    "ci": "npm ci && npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "keywords": [
    "node",
    "typescript",
    "sso",
    "hmac",
    "acl",
    "authentication"
  ],
  "dependencies": {
    "@naskot/node-hmac-auth-core": "^1.0.0",
    "ws": "^8.21.3",
    "@naskot/node-hmac-auth-core-propagation": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.6.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.4"
  }
}
