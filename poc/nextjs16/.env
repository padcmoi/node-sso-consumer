# Nothing here is a secret and nothing here is about the SSO.
#
# The identity, the callback URL, the gate, the broker credentials and the password
# that seals the cookie all come back from the pairing and live in `app_settings`.
#
# What is left is the database this application owns, and the two ports it publishes.

# Bound to the loopback, both of them: this POC is reached over HTTPS through a
# reverse proxy on this machine, which forwards to 127.0.0.1:7009. A port on 0.0.0.0
# would be the same application answering in plain HTTP beside the certificate, on an
# address the session cookie is not `Secure` for.
APP_PORT=7009
PMA_PORT=7013

DB_NAME=console
DB_USER=console
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
