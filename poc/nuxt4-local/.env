# Nothing here is a secret and nothing here is about the SSO.
#
# There is no provider to reach, no install token to copy and no credential to hold.
# The one value the library keeps - the password that seals the cookie - is minted at
# the first boot and lives in `app_settings`. That is the point: an installation with
# no `.env` to transcribe, even offline.
#
# What is left is the database this application owns, and the two ports it publishes.

APP_PORT=7020
PMA_PORT=7021

DB_NAME=app
DB_USER=app
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
