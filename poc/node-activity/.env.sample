# Copy to `.env` (never committed) and fill.

# The API of ONE x-core, WITH its port, and its login window.
XCORE_API=https://x-core.example.com:13001
XCORE_FRONT=https://x-sso.example.com

# An application the reader may enter: its consumer id, as the portal card names it.
CONSUMER=oauth-your-app

# A TEST account, never a real person's. It must hold the application's gate.
READER_EMAIL=
READER_PASSWORD=

# Optional. Where the reader signs in from, as app_sso would forward it. Leave it
# empty to be measured from this container's address.
READER_IP=

# Optional. The hash the application signs with. A development x-core does not
# verify signatures; any other one needs the real hash.
HMAC_HASH=
