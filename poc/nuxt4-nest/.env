# Nothing here is a secret and nothing here is about the SSO.
#
# The identity, the callback URL, the gate, the broker credentials and the password
# that seals the cookie all come back from the pairing and live in `app_settings`.
# That is what this POC demonstrates too - the difference with `nuxt4-nitro` is
# WHERE the library runs, not what it needs.
#
# What is left is the database the API owns, and the two ports the host publishes.

# BOUND TO THE LOOPBACK, both of them. This POC is meant to be reached over
# https://tvx-gp3.gestionpratique.ovh, which is a reverse proxy on this machine
# forwarding to 127.0.0.1:7010. A port published on 0.0.0.0 would be the same
# application answering in plain HTTP beside the certificate, on an address the
# cookie is not `Secure` for.
APP_PORT=7010
PMA_PORT=7011

DB_NAME=console
DB_USER=console
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
