# Copy to `.env` and replace every value. Nothing here is a secret: these are shapes to
# recognise, and a sample file carrying real values ends up copied as-is into production
# sooner or later.

# What the host publishes. The database itself publishes no port at all.
APP_PORT=7003
PMA_PORT=7004

DB_NAME=console
DB_USER=console
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# The account created on the very first boot, and only if it does not exist yet:
# changing these values afterwards neither renames nor resets the account in database.
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=changeme
